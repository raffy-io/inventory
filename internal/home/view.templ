package home

templ homepage() {
	<section class="h-dvh flex flex-col items-center justify-center">
		<h1 class="font-black text-8xl">Welcome</h1>
		<a
			href="/auth/login"
			class="inline-block f capitalize py-0.5 px-3 bg-red-500 text-red-50 rounded-sm hover:bg-red-400 transition-all duration-300"
		>get started</a>
	</section>
}
